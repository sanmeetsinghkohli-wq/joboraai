{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@jobora/types": [
        "../../packages/types/src/index.ts"
      ],
      "@jobora/types/*": [
        "../../packages/types/src/*"
      ],
      "@jobora/mocks": [
        "../../packages/mocks/src/index.ts"
      ],
      "@jobora/mocks/*": [
        "../../packages/mocks/src/*"
      ],
      "@jobora/backend": [
        "../../packages/backend/src/index.ts"
      ],
      "@jobora/backend/*": [
        "../../packages/backend/src/*"
      ],
      "@jobora/ui": [
        "../../packages/ui/src/index.ts"
      ],
      "@jobora/ui/*": [
        "../../packages/ui/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}

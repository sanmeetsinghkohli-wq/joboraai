{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "outDir": "../../dist/types",
    "rootDir": "src",
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
